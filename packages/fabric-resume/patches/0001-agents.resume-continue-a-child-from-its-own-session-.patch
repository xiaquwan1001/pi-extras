+  /**
+   * Record the launch a manual resume of this run must re-execute. Written only
+   * for a run that lives inside a session file, beside the run it describes.
+   */
+  #persistRunResume(managed: ManagedAgent, sessionFile: string, timeoutMs: number): void {
+    try {
+      writeRunResume(managed.runDirectory, {
+        format: RESUME_FORMAT,
+        id: managed.id,
+        cwd: managed.cwd,
+        task: managed.task,
+        sessionFile,
+        launch: { ...managed.launch, workerArguments: [...managed.launch.workerArguments] },
+        deadlineAt: Date.now() + timeoutMs,
+        attempts: 0,
+        writtenAt: Date.now(),
+      });
+    } catch {
+      // A run whose resume record cannot be written is simply not resumable.
+    }
+  }
+
+  /** Whether a child session file holds an actual transcript to continue from. */
+  #sessionHasTranscript(sessionFile: string): boolean {
+    try {
+      const size = fs.statSync(sessionFile).size;
+      const handle = fs.openSync(sessionFile, "r");
+      try {
+        const from = Math.max(0, size - 65_536);
+        const buffer = Buffer.alloc(Math.min(size, 65_536));
+        fs.readSync(handle, buffer, 0, buffer.length, from);
+        return buffer.toString("utf8").includes('"role"');
+      } finally {
+        fs.closeSync(handle);
+      }
+    } catch {
+      return false;
+    }
+  }
+
+  /**
+   * Continue a terminal child run from the session transcript it wrote
+   * (`agents.childSession`). The run keeps its identity — same id, run directory,
+   * cwd and launch — and the child reopens its own session file, so the work an
+   * interrupted attempt finished is carried instead of re-derived from a text
+   * summary. Only the launch this host recorded for this run is ever re-executed,
+   * and `MAX_MANUAL_RESUMES` bounds how often one run may be revived.
+   */
+  async resume(id: string, instruction?: string, timeoutMs?: number): Promise<AgentHandleInfo> {
+    const managed = this.#requireRun(id);
+    if (managed.hosted) {
+      throw new Error(`Fabric agent ${id} is a hosted run; its own runner owns its continuation`);
+    }
+    if (managed.runner !== "pi" && managed.runner !== "pi-durable") {
+      throw new Error(`Fabric agent ${id} runs on ${managed.runner}, which has no Fabric-owned session to resume`);
+    }
+    if (!managed.settled) throw new Error(`Fabric agent ${id} is still running; steer it or wait for it`);
+    const record = this.#readManagedRecord(managed) ?? readRecord(managed.statusFile);
+    if (!record || !terminalStatuses.has(record.status)) {
+      throw new Error(`Fabric agent ${id} has no terminal result to continue from`);
+    }
+    const authority = readRunResume(managed.runDirectory);
+    if (!authority) {
+      throw new Error(
+        `Fabric agent ${id} has no resume record: it was launched before agents.childSession was enabled, ` +
+        "or its run files were cleaned up. Enable agents.childSession and dispatch a new run to make children resumable.",
+      );
+    }
+    if (authority.attempts >= MAX_MANUAL_RESUMES) {
+      throw new Error(`Fabric agent ${id} already spent its ${MAX_MANUAL_RESUMES} manual resumes`);
+    }
+    const mismatch = runResumeMismatch(authority, {
+      runDirectory: managed.runDirectory,
+      workerPath: this.#workerPath,
+      cwd: managed.cwd,
+      ...(managed.childSessionFile ? { sessionFile: managed.childSessionFile } : {}),
+    });
+    if (mismatch) throw new Error(`Fabric agent ${id} cannot be resumed: ${mismatch}`);
+    if (!this.#sessionHasTranscript(authority.sessionFile)) {
+      throw new Error(`Fabric agent ${id} cannot be resumed: its session file holds no turns to continue`);
+    }
+    if (!fs.existsSync(managed.cwd)) {
+      throw new Error(`Fabric agent ${id} cannot be resumed: its working directory ${managed.cwd} no longer exists`);
+    }
+    if (this.#budget) {
+      const spent = readBudgetLedger(this.#budget.file).cost;
+      if (!budgetAdmits(spent, this.#budget.budget)) {
+        throw new Error(
+          `Fabric recursion budget exceeded: spent $${spent.toFixed(6)} of $${this.#budget.budget.toFixed(6)}. ` +
+          "Increase agents.budgetUsd or simplify the task.",
+        );
+      }
+    }
+    const release = await this.#semaphore.acquire("native");
+    if (this.#closing) {
+      release();
+      throw new Error("Fabric agent manager is closing");
+    }
+    this.#semaphore.admit(this.#currentDepth + 1);
+    const resumeTimeoutMs = effectiveAgentTimeoutMs(this.config.timeoutMs, timeoutMs);
+    const task = authority.task || managed.task;
+    const { turns, toolCalls, usage } = managed.observedProgress;
+    managed.task = task;
+    managed.childSessionFile = authority.sessionFile;
+    managed.resumeAttempts = authority.attempts + 1;
+    managed.stopRequested = false;
+    managed.background = true;
+    managed.completionNotified = false;
+    // Re-open the run handle: the resumed attempt settles on its own terms, and
+    // its permit returns to the admission semaphore when it does.
+    Object.assign(managed, createAgentLifecycle<AgentRunResult>(release));
+    // A continuation is a fresh prompt in the same session. The durable runner
+    // answers with the result it already recorded for the prompt it stored, so a
+    // resumed run continues on the plain Pi runner instead: same session file,
+    // cwd, model and tools, without the recorded-result replay.
+    if (managed.runner === "pi-durable") {
+      const workerArguments = [...managed.launch.workerArguments];
+      const runnerIndex = workerArguments.indexOf("--runner");
+      if (runnerIndex < 0) workerArguments.push("--runner", "pi");
+      else workerArguments[runnerIndex + 1] = "pi";
+      const durableIndex = workerArguments.indexOf("--durable-session");
+      if (durableIndex >= 0) workerArguments.splice(durableIndex, 2);
+      // Its session file is normally created by the worker; name it explicitly so
+      // the plain Pi runner reopens the transcript the durable attempt wrote.
+      setWorkerArgument(workerArguments, "session-file", authority.sessionFile);
+      managed.launch = { ...managed.launch, workerArguments };
+      managed.runner = "pi";
+      const piAdapter = getAgentRunner("pi");
+      if (piAdapter) managed.runnerAdapter = piAdapter;
+      // A durable recovery receipt describes the launch it was written for.
