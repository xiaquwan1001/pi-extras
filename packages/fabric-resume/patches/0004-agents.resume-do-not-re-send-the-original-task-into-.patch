   const finished = record.status === "completed";
@@ -436,14 +437,19 @@ const continuationTask = (
     finished
       ? "[Fabric continuation] Your coordinator is continuing the task you already worked on in this session."
       : "[Fabric continuation] Your previous attempt at this exact task stopped before it finished.",
-    `It ended with status "${record.status}"${record.error ? ` (${record.error})` : ""} after ${record.turns} turns and ${record.toolCalls} tool calls; your earlier turns are in this session, and the working tree already contains what that attempt completed.`,
+    `It ended with status "${record.status}"${record.error ? ` (${record.error})` : ""} after ${record.turns} turns and ${record.toolCalls} tool calls; your earlier turns, including the original task, are in this session, and the working tree already contains what that attempt completed.`,
     finished
-      ? "Read your earlier turns, then carry the task further from where you left off instead of starting over."
+      ? "Read your earlier turns, then carry the task further from where you left off; do not repeat output you already produced."
       : "Inspect the current state first, do not redo work that is already done, and carry the task through to completion.",
     ...(summary ? [`Last observed run activity: ${summary}`] : []),
     ...(instruction?.trim() ? [`Your coordinator adds: ${instruction.trim().slice(0, MAX_RESUME_NOTE_CHARS)}`] : []),
   ].join(" ");
-  return `${note.slice(0, MAX_RESUME_NOTE_CHARS * 2)}\n\n${task}`;
+  // The child reopens its own transcript, so the original prompt is already in its
+  // context; repeating it verbatim makes a continued run re-emit finished output.
+  // It is only re-sent when there is no transcript left to remember it from.
+  return includeTask
+    ? `${note.slice(0, MAX_RESUME_NOTE_CHARS * 2)}\n\n${task}`
+    : note.slice(0, MAX_RESUME_NOTE_CHARS * 2);
 };
 
