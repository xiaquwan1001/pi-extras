diff --git a/tests/agent-resume.test.ts b/tests/agent-resume.test.ts
index 7c546ed..93265b0 100644
--- a/tests/agent-resume.test.ts
+++ b/tests/agent-resume.test.ts
@@ -108,6 +108,24 @@ describe("resumable child agents", () => {
     await expect(manager.resume(handle.id)).rejects.toThrow(/no resume record/);
   });
 
+  it("resumes a run that never produced a turn as a fresh attempt", { timeout: 30_000 }, async () => {
+    // Stopped or killed before any turn: nothing to carry, so the same run may
+    // simply be tried again rather than refused for lacking a transcript.
+    const { manager } = createManager({ childSession: true });
+    const handle = await manager.spawn({
+      task: "DIE_BEFORE_SESSION immediately",
+      transport: "process",
+      timeoutMs: 20_000,
+    });
+    const died = await manager.wait(handle.id);
+    expect(died.status).toBe("failed");
+    const resumed = await manager.resume(handle.id);
+    expect(resumed.status).toBe("running");
+    const result = await manager.wait(handle.id);
+    expect(result.status).toBe("completed");
+    expect(JSON.parse(result.text).task).toContain("[Fabric continuation]");
+  });
+
   it("bounds how often one run may be resumed", { timeout: 60_000 }, async () => {
     const { manager } = createManager({ childSession: true });
     const handle = await manager.spawn({ task: "Keep going", transport: "process", timeoutMs: 20_000 });
