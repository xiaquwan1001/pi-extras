+++ b/src/agents/resume-root.ts
@@ -0,0 +1,165 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+/**
+ * Durable run root for resumable children (`agents.childSession`).
+ *
+ * A managed temporary run root lives under the OS temp directory (`tmpfs` on
+ * Linux) and is removed when its session closes, so a child that outlived a
+ * host crash, a reboot, or a session restart lost the transcript and the
+ * `resume.json` launch authority that `agents.resume` re-executes. The runs of a
+ * resumable session therefore live under the user cache directory, keyed by the
+ * Pi session id they belong to: continuing that same session (`pi -c`, after a
+ * reboot too) finds the same root and its settled runs again, while another
+ * session never adopts them.
+ *
+ * The root stays bounded: a run keeps its artifacts for `retention.resumableRunMs`
+ * past its terminal record, and a session root with nothing younger than that is
+ * removed by whichever host sweeps next.
+ */
+
+/** Runs are named by a hyphenless UUID, exactly like the run ids that create them. */
+export const RESUMABLE_RUN_ID = /^[0-9a-f]{32}$/;
+
+const cacheHome = (): string => {
+  const configured = process.env.XDG_CACHE_HOME?.trim();
+  return configured && path.isAbsolute(configured) ? configured : path.join(os.homedir(), ".cache");
+};
+
+/**
+ * Base directory holding one run root per session. `PI_FABRIC_RESUME_ROOT`
+ * overrides it (tests, or a machine whose home is not writable).
+ */
+export const resumableRunsRoot = (): string => {
+  const configured = process.env.PI_FABRIC_RESUME_ROOT?.trim();
+  if (configured && path.isAbsolute(configured)) return configured;
+  return path.join(cacheHome(), "pi-fabric", "runs");
+};
+
+/** Session directory name: readable, filesystem-safe, and unique per session id. */
+export const sanitizeSessionId = (sessionId: string): string =>
+  sessionId.replace(/[^A-Za-z0-9_-]/g, "_").slice(0, 120);
+
+export const sessionRunRoot = (base: string, sessionId: string): string =>
+  path.join(base, sanitizeSessionId(sessionId));
+
+/** Only the fields retention needs; a malformed record keeps its run alive. */
+const readStatus = (runDirectory: string): { status?: string; finishedAt?: number; updatedAt?: number } | undefined => {
+  try {
+    const parsed: unknown = JSON.parse(fs.readFileSync(path.join(runDirectory, "status.json"), "utf8"));
+    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return undefined;
+    const record = parsed as { status?: unknown; finishedAt?: unknown; updatedAt?: unknown };
+    return {
+      ...(typeof record.status === "string" ? { status: record.status } : {}),
+      ...(typeof record.finishedAt === "number" ? { finishedAt: record.finishedAt } : {}),
+      ...(typeof record.updatedAt === "number" ? { updatedAt: record.updatedAt } : {}),
+    };
+  } catch {
+    return undefined;
+  }
+};
+
+const newestMtimeMs = (directory: string): number => {
+  let newest = 0;
+  const visit = (target: string): void => {
+    let stat: fs.Stats;
+    try {
+      stat = fs.lstatSync(target);
+    } catch {
+      return;
+    }
+    newest = Math.max(newest, stat.mtimeMs);
+    if (!stat.isDirectory()) return;
+    let entries: string[];
+    try {
+      entries = fs.readdirSync(target);
+    } catch {
+      return;
+    }
+    for (const entry of entries) visit(path.join(target, entry));
+  };
+  visit(directory);
+  return newest;
+};
+
+export interface ResumableSweepResult {
+  removedRuns: string[];
+  removedRoots: string[];
+}
+
+/**
+ * Reclaim expired resumable runs. Runs are judged by their terminal record's
+ * finish time (falling back to the files they left); a session root is removed
+ * once nothing inside it is newer than the retention window. The current root is
+ * never removed, and a run without a terminal record is left alone: it may still
+ * be running under another host.
+ */
+export const sweepResumableRuns = (options: {
+  base: string;
+  currentRoot: string;
+  retentionMs: number;
+  now?: number;
+}): ResumableSweepResult => {
+  const now = options.now ?? Date.now();
+  const result: ResumableSweepResult = { removedRuns: [], removedRoots: [] };
+  const expired = (finishedAt: number | undefined, fallback: number): boolean =>
+    now - (finishedAt ?? fallback) >= options.retentionMs;
+  let sessionEntries: fs.Dirent[];
+  try {
+    sessionEntries = fs.readdirSync(options.base, { withFileTypes: true });
+  } catch {
+    return result;
+  }
+  for (const entry of sessionEntries) {
+    if (!entry.isDirectory()) continue;
+    const root = path.join(options.base, entry.name);
+    const isCurrent = path.resolve(root) === path.resolve(options.currentRoot);
+    if (!isCurrent) {
+      const newest = newestMtimeMs(root);
+      if (newest !== 0 && expired(newest, newest)) {
+        try {
+          fs.rmSync(root, { recursive: true, force: true });
+          result.removedRoots.push(root);
+        } catch {
+          // Another host is using it, or it is already gone.
+        }
+      }
+      continue;
+    }
+    let runs: fs.Dirent[];
+    try {
+      runs = fs.readdirSync(root, { withFileTypes: true });
+    } catch {
+      continue;
+    }
+    for (const run of runs) {
+      if (!run.isDirectory() || !RESUMABLE_RUN_ID.test(run.name)) continue;
+      const runDirectory = path.join(root, run.name);
+      const record = readStatus(runDirectory);
+      if (!record) {
+        // No status yet: either a launch in flight or the leftovers of one. Only
+        // a run whose files are older than the window is provably abandoned.
+        const newest = newestMtimeMs(runDirectory);
+        if (newest !== 0 && expired(undefined, newest)) {
+          try {
+            fs.rmSync(runDirectory, { recursive: true, force: true });
+            result.removedRuns.push(runDirectory);
+          } catch {
+            // Leave it for the next sweep.
+          }
+        }
+        continue;
+      }
+      if (record.status === "running") continue;
+      if (!expired(record.finishedAt ?? record.updatedAt, record.updatedAt ?? 0)) continue;
+      try {
+        fs.rmSync(runDirectory, { recursive: true, force: true });
+        result.removedRuns.push(runDirectory);
+      } catch {
+        // Leave it for the next sweep.
+      }
+    }
+  }
+  return result;
+};
