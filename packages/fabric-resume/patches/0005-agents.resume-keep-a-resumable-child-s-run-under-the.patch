+  #recordChildPid(id: string, transport: AgentTransportHandle): void {
+    const pid = transport.kind === "process" ? Number(transport.sessionId) : NaN;
+    if (!Number.isInteger(pid) || pid <= 0) return;
+    try {
+      fs.writeFileSync(path.join(this.#runRoot, id, "child.pid"), `${pid}\n`, { encoding: "utf8", mode: 0o600 });
+    } catch {
+      // A run directory this host cannot write simply records no child pid.
+    }
+  }
+
+  /** Whether a pid from a dead host's run directory still has a process behind it. */
+  #pidIsAlive(pid: number | undefined): boolean {
+    if (pid === undefined) return false;
+    try {
+      process.kill(pid, 0);
+      return true;
+    } catch (error) {
+      return (error as NodeJS.ErrnoException)?.code === "EPERM";
+    }
+  }
