diff --git a/scripts/manual-resume-e2e.ts b/scripts/manual-resume-e2e.ts
new file mode 100644
index 0000000..febcaf3
--- /dev/null
+++ b/scripts/manual-resume-e2e.ts
@@ -0,0 +1,51 @@
+// Manual end-to-end check: a real Pi child, resumed from its own session file.
+// Run with: PI_FABRIC_NODE_BINARY=$PWD/node_modules/.bin/bun node_modules/.bin/bun scripts/manual-resume-e2e.ts <provider/model>
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { DEFAULT_FABRIC_CONFIG } from "../src/config.js";
+import { AgentManager } from "../src/agents/manager.js";
+import { readRunResume } from "../src/agents/resume.js";
+
+const model = process.argv[2] || "custom.ustc-pool/ustc-dsf";
+const root = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "pi-fabric-resume-e2e-")));
+const manager = new AgentManager(process.cwd(), {
+  ...DEFAULT_FABRIC_CONFIG.agents,
+  runner: "pi", // from the source tree only the plain runner can launch; the shipped pi-durable default is covered by the live `agents.resume` smoke
+  retainRuns: true,
+  childSession: true,
+  timeoutMs: 180_000,
+  thinking: "off",
+  extensions: true,
+}, { runRoot: root, fullCodeMode: false });
+
+const TOKEN = "ZEBRA-77";
+try {
+  const handle = await manager.spawn({
+    task: `Remember this token for later: ${TOKEN}. Acknowledge with the single word OK. Do not use any tool.`,
+    transport: "process",
+    model,
+    tools: ["read"],
+    timeoutMs: undefined,
+  });
+  console.log("spawned", handle.id, handle.model ?? model);
+  const first = await manager.wait(handle.id);
+  console.log("attempt 1:", first.status, JSON.stringify(first.text.slice(0, 200)));
+  const runDirectory = manager.runDirectory(handle.id);
+  const sessionFile = path.join(String(runDirectory), "child-session", "session.jsonl");
+  console.log("session file:", fs.existsSync(sessionFile) ? `${sessionFile} (${fs.statSync(sessionFile).size} bytes)` : "MISSING");
+  console.log("resume record:", JSON.stringify(readRunResume(String(runDirectory))?.sessionFile));
+  if (first.status !== "completed") throw new Error("first attempt did not complete");
+
+  const resumed = await manager.resume(handle.id, `Question to answer from your own earlier turns in this session (do not use tools, ignore the earlier acknowledgment instruction): which token was you given earlier? Answer with just the token.`);
+  console.log("resumed:", resumed.status, "attempt counter:", readRunResume(String(runDirectory))?.attempts);
+  const second = await manager.wait(handle.id);
+  console.log("attempt 2:", second.status, JSON.stringify(second.text.slice(0, 300)));
+  console.log("session file after:", `${fs.statSync(sessionFile).size} bytes`);
+  const carried = second.status === "completed" && second.text.includes(TOKEN);
+  console.log(carried ? "PASS: the resumed child still knew the token from its own transcript"
+    : `FAIL: token not carried (status ${second.status})`);
+} finally {
+  await manager.close();
+  fs.rmSync(root, { recursive: true, force: true });
+}
