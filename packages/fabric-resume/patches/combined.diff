new file mode 100644
index 0000000..7679cea
--- /dev/null
+++ b/src/agents/resume.ts
@@ -0,0 +1,169 @@
+import fs from "node:fs";
+import path from "node:path";
+import type { AgentTransportLaunch } from "./types.js";
+
+/**
+ * Resume authority for a run whose child kept its own Pi session file
+ * (`agents.childSession`).
+ *
+ * `agents.resume` relaunches the run's worker, so it needs the exact launch the
+ * original attempt used. Worker-written status is telemetry, never authority: a
+ * process running as this user could otherwise point a relaunch at another
+ * program, directory, or run id. This record is written by the host that spawned
+ * the run, beside the run it describes, and re-read with every field checked
+ * against this manager's own worker entry, run root, and cwd — the same shape of
+ * check `worker-recovery.ts` applies to an interrupted durable worker.
+ *
+ * The file exists only for runs launched with `agents.childSession`, and it is
+ * removed with the run directory (`agents.cleanup`, run retention).
+ */
+export const RESUME_FILE = "resume.json";
+export const RESUME_FORMAT = 1;
+/** Manual resumes one run may be granted before Fabric refuses. */
+export const MAX_MANUAL_RESUMES = 3;
+/** Larger files are refused unread: a launch is far smaller than this. */
+export const RESUME_MAX_BYTES = 256 * 1024;
+
+export interface RunResumeRecord {
+  format: typeof RESUME_FORMAT;
+  id: string;
+  cwd: string;
+  task: string;
+  /** Fabric-owned Pi session file the child ran inside; resume reopens it. */
+  sessionFile: string;
+  launch: AgentTransportLaunch;
+  /** Wall-clock deadline the original attempt was given; a resume gets a fresh one. */
+  deadlineAt: number;
+  /** Manual resumes granted so far. */
+  attempts: number;
+  /** Process that last wrote this record; a dead one means the run is adoptable. */
+  hostPid?: number;
+  writtenAt: number;
+}
+
+export const resumePath = (runDirectory: string): string => path.join(runDirectory, RESUME_FILE);
+
+export const writeRunResume = (runDirectory: string, record: RunResumeRecord): void => {
+  fs.mkdirSync(path.dirname(resumePath(runDirectory)), { recursive: true, mode: 0o700 });
+  fs.writeFileSync(resumePath(runDirectory), JSON.stringify(record, null, 2), {
+    encoding: "utf8",
+    mode: 0o600,
+  });
+};
+
+export const removeRunResume = (runDirectory: string): void => {
+  try {
+    fs.rmSync(resumePath(runDirectory), { force: true });
+  } catch {
+    // A run directory this host cannot write has nothing left to resume.
+  }
+};
+
+const readLaunch = (value: unknown): AgentTransportLaunch | undefined => {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return undefined;
+  const launch = value as Partial<AgentTransportLaunch>;
+  if (typeof launch.id !== "string" || typeof launch.name !== "string"
+    || typeof launch.cwd !== "string" || typeof launch.workerPath !== "string"
+    || !Array.isArray(launch.workerArguments)
+    || launch.workerArguments.some((argument) => typeof argument !== "string")) return undefined;
+  return {
+    id: launch.id,
+    name: launch.name,
+    cwd: launch.cwd,
+    workerPath: launch.workerPath,
+    workerArguments: [...launch.workerArguments],
+  };
+};
+
+/**
+ * Strict reader: copies named, validated fields and refuses anything else. The
+ * record's id must name the run directory it sits in, so a file copied from
+ * another run is never read as this one. Returns undefined for a missing,
+ * oversized, or malformed file — an unreadable marker is never launch authority.
+ */
+export const readRunResume = (runDirectory: string): RunResumeRecord | undefined => {
+  const file = resumePath(runDirectory);
+  let size: number;
+  try {
+    const stat = fs.lstatSync(file);
+    if (!stat.isFile() || stat.isSymbolicLink()) return undefined;
+    size = stat.size;
+  } catch {
+    return undefined;
+  }
+  if (size > RESUME_MAX_BYTES) return undefined;
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(fs.readFileSync(file, "utf8"));
+  } catch {
+    return undefined;
+  }
+  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return undefined;
+  const record = parsed as Partial<RunResumeRecord>;
+  if (record.format !== RESUME_FORMAT || typeof record.id !== "string"
+    || record.id !== path.basename(runDirectory)
+    || typeof record.cwd !== "string" || typeof record.task !== "string"
+    || typeof record.sessionFile !== "string" || !path.isAbsolute(record.sessionFile)
+    || typeof record.deadlineAt !== "number" || !Number.isFinite(record.deadlineAt)
+    || typeof record.writtenAt !== "number" || !Number.isFinite(record.writtenAt)) return undefined;
+  const attempts = typeof record.attempts === "number" && Number.isInteger(record.attempts) && record.attempts >= 0
+    ? record.attempts
+    : 0;
+  const hostPid = typeof record.hostPid === "number" && Number.isInteger(record.hostPid) && record.hostPid > 0
+    ? record.hostPid
+    : undefined;
+  const launch = readLaunch(record.launch);
+  if (!launch) return undefined;
+  return {
+    format: RESUME_FORMAT,
+    id: record.id,
+    cwd: record.cwd,
+    task: record.task,
+    sessionFile: record.sessionFile,
+    launch,
+    deadlineAt: record.deadlineAt,
+    attempts,
+    ...(hostPid !== undefined ? { hostPid } : {}),
+    writtenAt: record.writtenAt,
+  };
+};
+
+/**
+ * Why this record must not be executed here, or undefined when it may. Every
+ * launch field must match what this host would have launched itself: the worker
+ * entry, the run id, the run's own directory and cwd, and the session file must
+ * sit inside that run directory.
+ */
+export const runResumeMismatch = (
+  record: RunResumeRecord,
+  expected: {
+    runDirectory: string;
+    workerPath: string;
+    cwd: string;
+    sessionFile?: string;
+  },
+): string | undefined => {
+  if (record.launch.id !== record.id) return "the resume launch names another run";
+  if (record.launch.workerPath !== expected.workerPath) return "the resume launch points at another worker entry";
+  if (record.launch.cwd !== record.cwd) return "the resume launch runs in another directory";
+  if (expected.cwd !== record.cwd) return "the resume launch runs in another directory than the run record";
+  if (fs.realpathSync.native(expected.runDirectory) !== path.dirname(record.sessionFile)
+    && !record.sessionFile.startsWith(`${fs.realpathSync.native(expected.runDirectory)}${path.sep}`)) {
+    return "the resume session file is outside the run directory";
+  }
+  if (expected.sessionFile && record.sessionFile !== expected.sessionFile) {
+    return "the resume session file is not the one this run was launched with";
+  }
+  const argument = (name: string): string | undefined => {
+    const index = record.launch.workerArguments.indexOf(`--${name}`);
+    return index < 0 ? undefined : record.launch.workerArguments[index + 1];
+  };
+  if (argument("cwd") !== undefined && argument("cwd") !== record.cwd) {
+    return "the resume launch carries a cwd that disagrees with its run";
+  }
+  if (argument("status-file") !== undefined
+    && path.dirname(String(argument("status-file"))) !== fs.realpathSync.native(expected.runDirectory)) {
+    return "the resume launch writes another run's status file";
+  }
+  return undefined;
+};
