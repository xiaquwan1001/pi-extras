new file mode 100755
index 0000000..2ee11ea
--- /dev/null
+++ b/tests/fixtures/fake-pi-rpc-session.mjs
@@ -0,0 +1,112 @@
+#!/usr/bin/env node
+// Fake Pi for the resumable-child tests: it appends transcript entries to the
+// session file it was launched with (what a real Pi session does) and echoes the
+// task back, so a test can see exactly what a continued child was handed.
+
+import fs from "node:fs";
+import readline from "node:readline";
+
+const argv = process.argv.slice(2);
+const flag = (name) => {
+  const index = argv.indexOf(name);
+  return index < 0 || index + 1 >= argv.length ? undefined : argv[index + 1];
+};
+const sessionFile = flag("--session");
+
+const send = (event) => {
+  process.stdout.write(`${JSON.stringify(event)}\n`);
+};
+
+const usage = { input: 3, output: 4, cacheRead: 0, cacheWrite: 0 };
+
+const successMessage = (text) => ({
+  role: "assistant",
+  content: [{ type: "text", text }],
+  provider: "fake",
+  model: "fake-model",
+  usage,
+  stopReason: "stop",
+});
+
+const finishAttempt = (message) => {
+  send({ type: "message_end", message });
+  send({ type: "turn_end", message, toolResults: [] });
+  send({ type: "agent_end", messages: [message], willRetry: false });
+  send({ type: "agent_settled" });
+};
+
+/** Append one user turn and one assistant turn: the transcript a resume continues from. */
+const appendTranscript = (task) => {
+  if (!sessionFile) return 0;
+  let turns = 0;
+  try {
+    turns = fs.readFileSync(sessionFile, "utf8").split("\n").filter((line) => line.includes('"role"')).length;
+  } catch {
+    turns = 0;
+  }
+  const timestamp = () => new Date().toISOString();
+  const entries = [
+    { type: "message", id: `user-${turns}`, parentId: null, timestamp: timestamp(), message: { role: "user", content: task } },
+    {
+      type: "message",
+      id: `assistant-${turns}`,
+      parentId: `user-${turns}`,
+      timestamp: timestamp(),
+      message: {
+        role: "assistant",
+        content: [{ type: "text", text: `attempt ${turns / 2 + 1} turn` }],
+        provider: "fake",
+        model: "fake-model",
+        usage,
+        stopReason: "stop",
+      },
+    },
+  ];
+  fs.appendFileSync(sessionFile, `${entries.map((entry) => JSON.stringify(entry)).join("\n")}\n`, "utf8");
+  return turns / 2 + 1;
+};
+
+let started = false;
+const recorded = [];
+const input = readline.createInterface({ input: process.stdin, crlfDelay: Infinity });
+input.on("line", (line) => {
+  if (!line.trim()) return;
+  let command;
+  try {
+    command = JSON.parse(line);
+  } catch {
+    return;
+  }
+  // The durable runner reads its answer back out of the session it recorded.
+  if (command.type === "get_messages") {
+    send({ type: "response", id: command.id, command: "get_messages", success: true, data: { messages: recorded } });
+    return;
+  }
+  if (started) return;
+  started = true;
+  const task = typeof command.message === "string" ? command.message : "";
+
+  send({ type: "response", command: "prompt", success: true });
+  send({ type: "agent_start" });
+
+  if (task.includes("DIE_BEFORE_SESSION") && !task.includes("[Fabric continuation]")) {
+    // Killed before the child opened a turn: the run has no transcript at all.
+    process.exit(1);
+  }
+
+  if (task.includes("DIE_WITHOUT_RESULT") && !task.includes("[Fabric continuation]")) {
+    // Mid-run interruption: work lands in the session, then the child dies.
+    appendTranscript(task);
+    process.exit(1);
+  }
+
+  const attempt = appendTranscript(task);
+  const message = successMessage(JSON.stringify({ attempt, task }));
+  recorded.push({ role: "user", content: task }, message);
+  finishAttempt(message);
+});
+
+process.stdin.on("end", () => {
+  setTimeout(() => process.exit(0), 5);
+});
+process.stdin.resume();
