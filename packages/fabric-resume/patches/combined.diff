diff --git a/tests/agent-resume.test.ts b/tests/agent-resume.test.ts
new file mode 100644
index 0000000..3d9c01e
--- /dev/null
+++ b/tests/agent-resume.test.ts
@@ -0,0 +1,347 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { DEFAULT_FABRIC_CONFIG } from "../src/config.js";
+import { AgentManager } from "../src/agents/manager.js";
+import { MAX_MANUAL_RESUMES, readRunResume } from "../src/agents/resume.js";
+import { sweepResumableRuns } from "../src/agents/resume-root.js";
+
+const managers: AgentManager[] = [];
+const roots: string[] = [];
+const fakePi = path.resolve("tests/fixtures/fake-pi-rpc-session.mjs");
+fs.chmodSync(fakePi, 0o755);
+
+afterEach(async () => {
+  await Promise.all(managers.splice(0).map((manager) => manager.close()));
+  for (const root of roots.splice(0)) fs.rmSync(root, { recursive: true, force: true });
+});
+
+const createManager = (agents: Partial<typeof DEFAULT_FABRIC_CONFIG.agents> = {}) => {
+  const root = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "pi-fabric-resume-")));
+  roots.push(root);
+  const manager = new AgentManager(process.cwd(), {
+    ...DEFAULT_FABRIC_CONFIG.agents,
+    runner: "pi",
+    retainRuns: true,
+    ...agents,
+  }, {
+    workerPath: path.resolve("src/worker.ts"),
+    piBinary: fakePi,
+    runRoot: root,
+    fullCodeMode: false,
+  });
+  managers.push(manager);
+  return { manager, root };
+};
+
+const transcriptTurns = (sessionFile: string): number => fs.readFileSync(sessionFile, "utf8")
+  .split("\n")
+  .filter((line) => line.includes('"role"'))
+  .length;
+
+describe("resumable child agents", () => {
+  it("continues a finished child from the session transcript it wrote", { timeout: 30_000 }, async () => {
+    const { manager, root } = createManager({ childSession: true });
+    const handle = await manager.spawn({ task: "Build the lane", transport: "process", timeoutMs: 20_000 });
+    const first = await manager.wait(handle.id);
+    expect(first.status).toBe("completed");
+    expect(JSON.parse(first.text)).toMatchObject({ attempt: 1, task: "Build the lane" });
+
+    const runDirectory = manager.runDirectory(handle.id);
+    expect(runDirectory).toBeDefined();
+    const sessionFile = path.join(String(runDirectory), "child-session", "session.jsonl");
+    expect(fs.existsSync(sessionFile)).toBe(true);
+    expect(transcriptTurns(sessionFile)).toBe(2);
+    const authority = readRunResume(String(runDirectory));
+    expect(authority?.sessionFile).toBe(fs.realpathSync(sessionFile));
+    expect(authority?.attempts).toBe(0);
+
+    const resumed = await manager.resume(handle.id, "also land the regression test");
+    expect(resumed.id).toBe(handle.id);
+    expect(resumed.status).toBe("running");
+
+    const second = await manager.wait(handle.id);
+    expect(second.status).toBe("completed");
+    const continued = JSON.parse(second.text);
+    // The child reopened its own session: the transcript grew instead of restarting.
+    expect(continued.attempt).toBe(2);
+    expect(transcriptTurns(sessionFile)).toBe(4);
+    // It was handed its original task plus a continuation note carrying the instruction.
+    expect(continued.task).toContain("[Fabric continuation]");
+    expect(continued.task).toContain("also land the regression test");
+    // The child already has the original task in its own transcript; re-sending it
+    // verbatim is what makes a continued run repeat finished output.
+    expect(continued.task.trim().endsWith("Build the lane")).toBe(false);
+    expect(readRunResume(String(runDirectory))?.attempts).toBe(1);
+    // The run kept its identity: same run directory, inside this test's run root.
+    expect(fs.realpathSync(String(runDirectory))).toContain(root);
+  });
+
+  it("revives a child that died with work in flight", { timeout: 30_000 }, async () => {
+    const { manager } = createManager({ childSession: true });
+    const handle = await manager.spawn({
+      task: "DIE_WITHOUT_RESULT after writing the first draft",
+      transport: "process",
+      timeoutMs: 20_000,
+    });
+    const interrupted = await manager.wait(handle.id);
+    expect(interrupted.status).toBe("failed");
+
+    const runDirectory = String(manager.runDirectory(handle.id));
+    const sessionFile = path.join(runDirectory, "child-session", "session.jsonl");
+    expect(transcriptTurns(sessionFile)).toBe(2);
+
+    const resumed = await manager.resume(handle.id);
+    expect(resumed.status).toBe("running");
+    const result = await manager.wait(handle.id);
+    expect(result.status).toBe("completed");
+    expect(JSON.parse(result.text).attempt).toBe(2);
+  });
+
+  // The default `pi-durable` runner keeps a recorded-result journal of its own, so
+  // `agents.resume` re-runs the continuation on the plain `pi` runner (same session
+  // file). That path needs a real Pi session runtime and is covered by
+  // scripts/manual-resume-e2e.ts against a live model, not by the fake-RPC fixture.
+
+  it("refuses to resume a run that was launched without a child session", { timeout: 30_000 }, async () => {
+    const { manager } = createManager();
+    const handle = await manager.spawn({ task: "One shot", transport: "process", timeoutMs: 20_000 });
+    expect((await manager.wait(handle.id)).status).toBe("completed");
+    await expect(manager.resume(handle.id)).rejects.toThrow(/no resume record/);
+  });
+
+  it("resumes a run that never produced a turn as a fresh attempt", { timeout: 30_000 }, async () => {
+    // Stopped or killed before any turn: nothing to carry, so the same run may
+    // simply be tried again rather than refused for lacking a transcript.
+    const { manager } = createManager({ childSession: true });
+    const handle = await manager.spawn({
+      task: "DIE_BEFORE_SESSION immediately",
+      transport: "process",
+      timeoutMs: 20_000,
+    });
+    const died = await manager.wait(handle.id);
+    expect(died.status).toBe("failed");
+    const resumed = await manager.resume(handle.id);
+    expect(resumed.status).toBe("running");
+    const result = await manager.wait(handle.id);
+    expect(result.status).toBe("completed");
+    const fresh = JSON.parse(result.text);
+    expect(fresh.task).toContain("[Fabric continuation]");
+    // Nothing to remember the task from, so it is re-sent with the note.
+    expect(fresh.task).toContain("DIE_BEFORE_SESSION immediately");
+  });
+
+  it("bounds how often one run may be resumed", { timeout: 60_000 }, async () => {
+    const { manager } = createManager({ childSession: true });
+    const handle = await manager.spawn({ task: "Keep going", transport: "process", timeoutMs: 20_000 });
+    await manager.wait(handle.id);
+    for (let index = 0; index < MAX_MANUAL_RESUMES; index += 1) {
+      expect((await manager.resume(handle.id)).status).toBe("running");
+      expect((await manager.wait(handle.id)).status).toBe("completed");
+    }
+    await expect(manager.resume(handle.id)).rejects.toThrow(/manual resumes/);
+  });
+
+  it("resumes a run settled by an earlier host of the same session", { timeout: 60_000 }, async () => {
+    // The hardware crash this is about: the child process dies, and so does the
+    // Pi host that owned its run. Continuing the same session must still find
+    // the transcript and the launch authority, because resumable runs live under
+    // the cache directory keyed by session id, not in a temporary run root.
+    const base = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "pi-fabric-resume-cache-")));
+    roots.push(base);
+    const previous = process.env.PI_FABRIC_RESUME_ROOT;
+    const previousRunRoot = process.env.PI_FABRIC_RUN_ROOT;
+    delete process.env.PI_FABRIC_RUN_ROOT;
+    process.env.PI_FABRIC_RESUME_ROOT = base;
+    const createSessionManager = () => {
+      const manager = new AgentManager(process.cwd(), {
+        ...DEFAULT_FABRIC_CONFIG.agents,
+        runner: "pi",
+        retainRuns: false,
+        childSession: true,
+      }, {
+        workerPath: path.resolve("src/worker.ts"),
+        piBinary: fakePi,
+        sessionId: () => "session-under-test",
+        fullCodeMode: false,
+      });
+      managers.push(manager);
+      return manager;
+    };
+    try {
+      const crashed = createSessionManager();
+      const handle = await crashed.spawn({ task: "Build the lane", transport: "process", timeoutMs: 20_000 });
+      expect((await crashed.wait(handle.id)).status).toBe("completed");
+      const runDirectory = String(crashed.runDirectory(handle.id));
+      expect(runDirectory.startsWith(path.join(base, "session-under-test"))).toBe(true);
+      // A graceful close (or a crash before one) leaves the resumable run behind.
+      await crashed.close();
+      managers.splice(managers.indexOf(crashed), 1);
+      expect(fs.existsSync(path.join(runDirectory, "resume.json"))).toBe(true);
+
+      // A later host of the same session adopts the settled run and continues it.
+      const next = createSessionManager();
+      const resumed = await next.resume(handle.id, "land the regression test too");
+      expect(resumed.status).toBe("running");
+      const result = await next.wait(handle.id);
+      expect(result.status, result.error).toBe("completed");
+      const continued = JSON.parse(result.text);
+      expect(continued.attempt).toBe(2);
+      expect(continued.task).toContain("land the regression test too");
+      expect(readRunResume(runDirectory)?.attempts).toBe(1);
+    } finally {
+      if (previous === undefined) delete process.env.PI_FABRIC_RESUME_ROOT;
+      else process.env.PI_FABRIC_RESUME_ROOT = previous;
+      if (previousRunRoot !== undefined) process.env.PI_FABRIC_RUN_ROOT = previousRunRoot;
+    }
+  });
+
+  it("reclaims resumable runs past their retention window", () => {
+    const base = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "pi-fabric-resume-sweep-")));
+    roots.push(base);
+    const currentRoot = path.join(base, "current-session");
+    const oldRun = "a".repeat(32);
+    const freshRun = "b".repeat(32);
+    const finished = (runId: string, at: number): void => {
+      const directory = path.join(currentRoot, runId);
+      fs.mkdirSync(directory, { recursive: true });
+      fs.writeFileSync(
+        path.join(directory, "status.json"),
+        JSON.stringify({ id: runId, status: "completed", updatedAt: at, finishedAt: at }),
+      );
+    };
+    const now = Date.now();
+    finished(oldRun, now - 8 * 24 * 60 * 60 * 1_000);
+    finished(freshRun, now - 60 * 60 * 1_000);
+    const oldSession = path.join(base, "abandoned-session");
+    const oldSessionRun = path.join(oldSession, "c".repeat(32));
+    fs.mkdirSync(oldSessionRun, { recursive: true });
+    const longAgo = new Date(now - 8 * 24 * 60 * 60 * 1_000);
+    fs.utimesSync(path.join(oldSessionRun), longAgo, longAgo);
+    fs.utimesSync(oldSession, longAgo, longAgo);
+
+    const swept = sweepResumableRuns({
+      base,
+      currentRoot,
+      retentionMs: 7 * 24 * 60 * 60 * 1_000,
+      now,
+    });
+    expect(swept.removedRuns).toContain(path.join(currentRoot, oldRun));
+    expect(fs.existsSync(path.join(currentRoot, oldRun))).toBe(false);
+    expect(fs.existsSync(path.join(currentRoot, freshRun))).toBe(true);
+    expect(swept.removedRoots).toContain(oldSession);
+    expect(fs.existsSync(oldSession)).toBe(false);
+    expect(fs.existsSync(currentRoot)).toBe(true);
+  });
+
+  it("adopts a run whose host died before it settled, once nothing is writing", { timeout: 60_000 }, async () => {
+    const base = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "pi-fabric-resume-crashed-")));
+    roots.push(base);
+    const previous = process.env.PI_FABRIC_RESUME_ROOT;
+    process.env.PI_FABRIC_RESUME_ROOT = base;
+    const createSessionManager = () => {
+      const manager = new AgentManager(process.cwd(), {
+        ...DEFAULT_FABRIC_CONFIG.agents,
+        runner: "pi",
+        retainRuns: false,
+        childSession: true,
+      }, {
+        workerPath: path.resolve("src/worker.ts"),
+        piBinary: fakePi,
+        sessionId: () => "crashed-session",
+        fullCodeMode: false,
+      });
+      managers.push(manager);
+      return manager;
+    };
+    try {
+      const first = createSessionManager();
+      const handle = await first.spawn({ task: "Build the lane", transport: "process", timeoutMs: 20_000 });
+      expect((await first.wait(handle.id)).status).toBe("completed");
+      const runDirectory = String(first.runDirectory(handle.id));
+      await first.close();
+      managers.splice(managers.indexOf(first), 1);
+      const statusFile = path.join(runDirectory, "status.json");
+      const settled = JSON.parse(fs.readFileSync(statusFile, "utf8"));
+      // The machine went down mid-run: the record still claims "running" and the
+      // host that wrote it is gone.
+      fs.writeFileSync(statusFile, JSON.stringify({ ...settled, status: "running", finishedAt: undefined }));
+      const stale = new Date(Date.now() - 10 * 60 * 1_000);
+      for (const file of ["status.json", "events.jsonl", "lifecycle.jsonl", path.join("child-session", "session.jsonl")]) {
+        const target = path.join(runDirectory, file);
+        if (fs.existsSync(target)) fs.utimesSync(target, stale, stale);
+      }
+
+      const next = createSessionManager();
+      const resumed = await next.resume(handle.id, "carry on after the crash");
+      expect(resumed.status).toBe("running");
+      const result = await next.wait(handle.id);
+      expect(result.status, result.error).toBe("completed");
+      expect(JSON.parse(result.text).attempt).toBe(2);
+      expect(readRunResume(runDirectory)?.attempts).toBe(1);
+    } finally {
+      if (previous === undefined) delete process.env.PI_FABRIC_RESUME_ROOT;
+      else process.env.PI_FABRIC_RESUME_ROOT = previous;
+    }
+  });
+
+  it("never adopts a run its own host still holds", { timeout: 30_000 }, async () => {
+    const { manager, root } = createManager({ childSession: true });
+    const handle = await manager.spawn({ task: "Build the lane", transport: "process", timeoutMs: 20_000 });
+    expect((await manager.wait(handle.id)).status).toBe("completed");
+    const runDirectory = path.join(root, handle.id);
+    const statusFile = path.join(runDirectory, "status.json");
+    const settled = JSON.parse(fs.readFileSync(statusFile, "utf8"));
+    fs.writeFileSync(statusFile, JSON.stringify({ ...settled, status: "running", finishedAt: undefined }));
+    // The run is still in this host's map, so the stale-looking record is never
+    // taken as an interrupted attempt: nothing is pre-empted behind a live host.
+    await expect(manager.resume(handle.id)).rejects.toThrow(/no terminal result/);
+  });
+
+  it("does not adopt an unsettled run whose child process is still alive", { timeout: 60_000 }, async () => {
+    const base = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "pi-fabric-resume-orphan-")));
+    roots.push(base);
+    const previous = process.env.PI_FABRIC_RESUME_ROOT;
+    process.env.PI_FABRIC_RESUME_ROOT = base;
+    const createSessionManager = () => {
+      const manager = new AgentManager(process.cwd(), {
+        ...DEFAULT_FABRIC_CONFIG.agents,
+        runner: "pi",
+        retainRuns: false,
+        childSession: true,
+      }, {
+        workerPath: path.resolve("src/worker.ts"),
+        piBinary: fakePi,
+        sessionId: () => "orphan-session",
+        fullCodeMode: false,
+      });
+      managers.push(manager);
+      return manager;
+    };
+    try {
+      const first = createSessionManager();
+      const handle = await first.spawn({ task: "Build the lane", transport: "process", timeoutMs: 20_000 });
+      expect((await first.wait(handle.id)).status).toBe("completed");
+      const runDirectory = String(first.runDirectory(handle.id));
+      await first.close();
+      managers.splice(managers.indexOf(first), 1);
+      const statusFile = path.join(runDirectory, "status.json");
+      const settled = JSON.parse(fs.readFileSync(statusFile, "utf8"));
+      fs.writeFileSync(statusFile, JSON.stringify({ ...settled, status: "running", finishedAt: undefined }));
+      const stale = new Date(Date.now() - 10 * 60 * 1_000);
+      for (const file of ["status.json", "events.jsonl", "lifecycle.jsonl", path.join("child-session", "session.jsonl")]) {
+        const target = path.join(runDirectory, file);
+        if (fs.existsSync(target)) fs.utimesSync(target, stale, stale);
+      }
+      // An orphaned child that outlived its host would be corrupted by a second
+      // writer on the same session file, so its liveness keeps the run unadopted.
+      fs.writeFileSync(path.join(runDirectory, "child.pid"), `${process.pid}\n`);
+      const next = createSessionManager();
+      await expect(next.resume(handle.id)).rejects.toThrow(/unknown to this session/);
+    } finally {
+      if (previous === undefined) delete process.env.PI_FABRIC_RESUME_ROOT;
+      else process.env.PI_FABRIC_RESUME_ROOT = previous;
+    }
+  });
+});
