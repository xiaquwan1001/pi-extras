{
  "name": "pi-extras",
  "private": true,
  "version": "0.0.0",
  "description": "Small, dependency-free Pi extensions: Fabric subagent echo, measured model speed, Fabric runtime hardening.",
  "license": "MIT",
  "author": "Qianhui Xu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaquwan1001/pi-extras.git"
